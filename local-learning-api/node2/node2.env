# Second local node, next to the normal one (defaults in brackets)
NODE_HTTP_PORT=8082                               # 8081
NODE_DB_PORT=5434                                 # 5432
NODE_ORCH_PORT=8093                               # 8091
NODE_CONTROLLER_PORT=8094                         # 8092
NODE_CONTROLLER_NAME=local-learning-controller-node2
NODE_NETWORK=local-learning-network-node2
NODE_ORCH_VOLUME=orch-data-node2
NODE_CLINIC_CSV=/connectors/clinic_002.csv        # clinic_001.csv

# own compose project, so node2 gets its own DB volume
QUARKUS_COMPOSE_DEVSERVICES_PROJECT_NAME=quarkus-devservices-local-learning-api-node2
