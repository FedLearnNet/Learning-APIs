      "hyperparams" : [ {
        "name" : "linkage",
        "variableName" : "linkage",
        "type" : "CATEGORICAL",
        "description" : "Linkage strategy for hierarchical merges. Note: 'ward' requires metric='euclidean'.",
        "mode" : "BOTH",
        "options" : [ "ward", "complete", "average", "single" ],
        "default" : "ward"
      }, {
        "name" : "compute_distances",
        "variableName" : "compute_distances",
        "type" : "BOOLEAN",
        "description" : "Store distances between merged clusters (needed for plotting an accurate dendrogram in some settings).",
        "mode" : "BOTH",
        "options" : [ ],
        "default" : "1"
      }, {
